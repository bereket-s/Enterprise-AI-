# Copy to .env and adjust for your environment.
# Defaults (SQLite, dev secret key) work out of the box for local development.

DATABASE_URL=sqlite:///./platform.db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Optional: enable the AI Copilot's LLM-backed answer phrasing (falls back to a
# deterministic template engine if unset — the platform is fully functional without it).
LLM_API_KEY=
LLM_PROVIDER=anthropic

# Serverless deployments (e.g. Vercel) have no persistent process for the
# in-process scheduler to run in — set this to false there and use a Vercel
# Cron Job hitting GET /api/internal/cron-tick instead (see backend/vercel.json
# and docs/deployment.md). Leave true for local dev and container hosts.
ENABLE_INPROCESS_SCHEDULER=true
# Required only when ENABLE_INPROCESS_SCHEDULER=false — must match the
# CRON_SECRET env var set on the Vercel project (Vercel sends it automatically
# as an Authorization: Bearer header on every cron invocation).
CRON_SECRET=

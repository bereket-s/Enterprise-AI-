# Copy to .env and adjust for your environment.
# Defaults (SQLite, dev secret key) work out of the box for local development.

DATABASE_URL=sqlite:///./platform.db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Optional: enable the AI Copilot's LLM-backed answer phrasing (falls back to a
# deterministic template engine if unset — the platform is fully functional without it).
LLM_API_KEY=
LLM_PROVIDER=anthropic
